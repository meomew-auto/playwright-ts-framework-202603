{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      // Core aliases
      "@infrastructure/*": ["src/infrastructure/*"],
      "@presentation/*": ["src/presentation/*"],
      "@auth": ["src/infrastructure/auth/index.ts"],
      "@auth/*": ["src/infrastructure/auth/*"],
      
      // Fixtures - dynamic wildcard + per project
      "@fixtures/common/*": ["src/infrastructure/fixtures/common/*"],
      "@fixtures/cms": ["src/infrastructure/fixtures/cms"],
      "@fixtures/cms/*": ["src/infrastructure/fixtures/cms/*"],
      "@fixtures/neko": ["src/infrastructure/fixtures/neko"],
      "@fixtures/neko/*": ["src/infrastructure/fixtures/neko/*"],
      "@fixtures/*": ["src/infrastructure/fixtures/*", "src/infrastructure/fixtures/*/index.ts"],
      
      // UI layer (Pages & Components) - dynamic wildcard + per project
      "@ui/*": ["src/infrastructure/ui/*"],
      "@pages/base/*": ["src/infrastructure/ui/pages/base/*"],
      "@pages/cms/*": ["src/infrastructure/ui/pages/cms/*"],
      "@pages/neko/*": ["src/infrastructure/ui/pages/neko-coffee/*"],
      "@pages/*": ["src/infrastructure/ui/pages/*"],
      
      // Helpers - common + per project
      "@helpers": ["src/infrastructure/helpers"],
      "@helpers/common": ["src/infrastructure/helpers/common"],
      "@helpers/common/*": ["src/infrastructure/helpers/common/*"],
      "@helpers/cms": ["src/infrastructure/helpers/cms"],
      "@helpers/cms/*": ["src/infrastructure/helpers/cms/*"],
      
      // Collection helpers (shortcut)
      "@collection/*": ["src/infrastructure/helpers/common/collection/*"],
      
      // Utils
      "@utils/*": ["src/infrastructure/utils/*"],
      
      // API Clients & Services & Schemas - dynamic wildcard + per project
      "@clients": ["src/infrastructure/api/clients"],
      "@clients/*": ["src/infrastructure/api/clients/*"],
      "@services/*": ["src/infrastructure/api/services/*"],
      "@schemas/common/*": ["src/infrastructure/api/schemas/common/*"],
      "@schemas/neko": ["src/infrastructure/api/schemas/neko"],
      "@schemas/neko/*": ["src/infrastructure/api/schemas/neko/*"],
      "@schemas/*": ["src/infrastructure/api/schemas/*"],
      
      // Components - per project
      "@components/cms/*": ["src/infrastructure/ui/components/cms/*"],
      
      // Data - universal & per project
      "@data": ["src/infrastructure/data/index.ts"],
      "@data/*": ["src/infrastructure/data/*"],
      "@data/common/*": ["src/infrastructure/data/common/*"],
      "@data/cms/*": ["src/infrastructure/data/cms/*"],
      "@data/neko/*": ["src/infrastructure/data/neko/*"]
    }
  },
  "include": ["src/**/*", "configs/**/*.ts", "playwright.config.ts"],
  "exclude": ["node_modules"]
}

